{
  "name": "@vaultcompass/vault-guard-monorepo",
  "version": "1.0.0",
  "description": "Security and optimization layer for AI-native coding (workspace root -- not published)",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 run test:coverage",
    "test:release-kind": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.release-kind.config.mjs",
    "test:windows": "pnpm --filter @vaultcompass/vault-guard-core test -- --testPathIgnorePatterns=pre-commit-hook && pnpm --filter @vaultcompass/vault-guard test -- --testPathIgnorePatterns=integration --testPathIgnorePatterns=__tests__.action",
    "gen:rules-doc": "node scripts/gen-rules-doc.cjs",
    "lint": "eslint .",
    "check:pack": "node scripts/check-pack.cjs",
    "check:private-names": "node scripts/check-private-names.cjs",
    "redos:sweep": "node scripts/redos-sweep.cjs",
    "redos:sweep:self-test": "node scripts/redos-sweep.cjs --self-test",
    "redos:sweep:update-baseline": "node scripts/redos-sweep.cjs --update-baseline",
    "prepublishOnly": "pnpm build",
    "release": "pnpm publish -r --access public --filter \"@vaultcompass/*\"",
    "bench": "node bench/run.cjs",
    "bench:action-install": "node bench/action-install.cjs --compare",
    "bench:action-install:update-baseline": "node bench/action-install.cjs --write-baseline",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:next": "pnpm build && pnpm check:pack && pnpm publish -r --tag next --no-git-checks --filter \"@vaultcompass/*\""
  },
  "keywords": [
    "cli",
    "security",
    "ai-coding",
    "guardrails",
    "secret-scanner",
    "token-optimization",
    "pre-commit-hook"
  ],
  "author": "Vault & Compass LLC",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vaultcompass/conductor": "0.4.0",
    "@vaultcompass/dep-guard": "0.6.0",
    "@vaultcompass/intent-guard": "1.4.0",
    "@vaultcompass/vault-guard": "1.4.6",
    "eslint": "^10.4.1",
    "jest": "^30.5.2",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "hono": "4.13.7",
      "@hono/node-server": "^2.0.12",
      "fast-uri": "^4.1.4",
      "brace-expansion": "^5.0.9",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "browserslist": "^4.28.7",
      "qs": "^6.16.0"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
